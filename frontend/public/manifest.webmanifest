{
  "id": "/",
  "name": "BeBetter",
  "short_name": "BeBetter",
  "description": "Post one photo or video of your progress every day. No filters needed. Only your effort counts.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "orientation": "portrait-primary",
  "categories": ["social", "lifestyle", "health"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Post today's progress", "short_name": "Post", "url": "/feed?create=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reels", "url": "/reels", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications", "url": "/notifications", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
