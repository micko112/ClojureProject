{
  "expo": {
    "name": "BeBetter",
    "slug": "bebetter",
    "scheme": "bebetter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "quest.bebetter.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "BeBetter uses the camera so you can capture your daily progress.",
        "NSMicrophoneUsageDescription": "BeBetter uses the microphone for videos and Live.",
        "NSPhotoLibraryUsageDescription": "BeBetter needs your photos so you can post your progress."
      }
    },
    "android": {
      "package": "quest.bebetter.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      ["expo-status-bar", { "style": "light" }],
      ["expo-navigation-bar", { "style": "light" }],
      [
        "expo-build-properties",
        {
          "android": { "usesCleartextTraffic": true }
        }
      ],
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
