# Copy to .env and fill in real values on the VPS.
# NEVER commit .env — it stays outside git.

# ─── Container registry (used by deploy.sh to pull images) ──────────────────
# Create a GitHub PAT (classic) with `read:packages` scope.
GHCR_USER=micko112
GHCR_TOKEN=ghp_replace_me

IMAGE_OWNER=micko112
IMAGE_TAG=latest

# ─── Domain + Let's Encrypt (used by certbot service) ───────────────────────
DOMAIN=bebetter.quest
CERTBOT_EMAIL=you@example.com

# ─── Backend runtime ────────────────────────────────────────────────────────
# Set to "true" on the FIRST boot only — resets and seeds the DB.
# Change back to "false" after first successful startup.
BEBETTER_SEED=false

# Public URL of the site: used in password-reset emails and as an allowed
# Origin for the CSRF guard.
APP_BASE_URL=https://bebetter.quest

# Comma-separated usernames allowed to use admin endpoints
# (/api/vision/status, /api/vision/retrain, /api/vision/export).
ADMIN_USERNAMES=

# Google sign-in: required for Google login (it's disabled when empty).
GOOGLE_CLIENT_ID=
# Facebook sign-in: both required (tokens are checked to belong to this app).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Email (password reset) ─────────────────────────────────────────────────
# Leave SMTP_HOST empty to log reset links to the backend output instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BeBetter <no-reply@bebetter.quest>
# SMTP_SSL=true   # implicit TLS (automatic on port 465)

# ─── Live video (WebRTC) ────────────────────────────────────────────────────
# Optional TURN relay; without it some mobile networks can't watch lives.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Activity classifier (ml service) ───────────────────────────────────────
# ML_URL defaults to http://ml:8000 in docker-compose.prod.yml; set it empty
# to turn suggestions off.
# ML_TIMEOUT_MS=2000
# Shared secret required by the ml service's /train endpoint (optional).
ML_TOKEN=

# ─── Media storage (photos / videos) ────────────────────────────────────────
# Leave S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY empty to keep files on the
# VPS disk (uploads volume). Recommended for production: Cloudflare R2
# (S3-compatible, no egress fees). See "Media storage (Cloudflare R2)" in
# DEPLOYMENT.md.
#
# Cloudflare R2:  S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
# AWS S3:         S3_ENDPOINT= (empty)  S3_REGION=eu-central-1
# MinIO:          S3_ENDPOINT=http://minio:9000  S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Key prefix inside the bucket (default "media/")
S3_PREFIX=media/
# Path-style URLs (bucket in the path). Defaults to true when S3_ENDPOINT is set.
# S3_FORCE_PATH_STYLE=true
# Public base URL the objects are served from (required for R2):
# your R2 custom domain (recommended) or the bucket's r2.dev URL. No trailing slash.
MEDIA_PUBLIC_BASE_URL=https://media.bebetter.quest
# Local storage directory when S3 is not configured (default: <workdir>/uploads)
# MEDIA_LOCAL_DIR=/app/uploads
